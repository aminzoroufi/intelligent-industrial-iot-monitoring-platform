# Local demonstration values only. Copy this file to .env before `make demo`.
# Rotate every value and use a secret manager before any non-local deployment.
IIOT_ENVIRONMENT=development
IIOT_DATABASE_URL=postgresql+psycopg://iiot_demo:local_demo_db_password@postgres:5432/iiot_demo
IIOT_JWT_SECRET=local-demo-jwt-secret-change-before-any-deployment
IIOT_INGEST_TOKEN=local-demo-ingest-token-change-before-any-deployment
IIOT_DEMO_ADMIN_USERNAME=demo-admin
IIOT_DEMO_ADMIN_PASSWORD=local-demo-admin-password
IIOT_MQTT_HOST=mosquitto
IIOT_MQTT_PORT=1883
IIOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
IIOT_OFFLINE_AFTER_S=60
IIOT_MAX_QUERY_DAYS=31
IIOT_MODEL_ROOT=data/models
IIOT_MODEL_STALE_AFTER_DAYS=30
IIOT_ANOMALY_POLL_INTERVAL_S=5
IIOT_ANOMALY_MINIMUM_FEATURE_ROWS=200

POSTGRES_DB=iiot_demo
POSTGRES_USER=iiot_demo
POSTGRES_PASSWORD=local_demo_db_password

# Browser-visible values contain no secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Set true only when the dashboard is served over HTTPS.
IIOT_COOKIE_SECURE=false
