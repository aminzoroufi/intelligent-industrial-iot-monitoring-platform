{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aminzoroufi/intelligent-industrial-iot-monitoring-platform/contracts/schemas/event.v1.schema.json",
  "title": "Industrial IoT event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "site_id", "device_id", "sequence", "device_time", "event_code", "severity", "state", "summary", "synthetic"],
  "properties": {
    "schema_version": {"const": 1},
    "message_id": {"type": "string", "format": "uuid"},
    "site_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "sequence": {"type": "integer", "minimum": 0},
    "device_time": {"type": ["string", "null"], "format": "date-time"},
    "event_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,47}$"},
    "severity": {"enum": ["info", "warning", "critical"]},
    "state": {"enum": ["active", "cleared", "diagnostic"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "synthetic": {"type": "boolean"},
    "details": {"type": "object", "maxProperties": 20}
  }
}

