{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aminzoroufi/intelligent-industrial-iot-monitoring-platform/contracts/schemas/availability.v1.schema.json",
  "title": "Industrial IoT availability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "device_id", "status", "reason"],
  "properties": {
    "schema_version": {"const": 1},
    "site_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "device_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "status": {"enum": ["online", "offline"]},
    "reason": {"enum": ["boot", "graceful_disconnect", "connection_lost", "broker_lwt"]}
  }
}

